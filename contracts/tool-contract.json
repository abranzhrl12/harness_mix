{
  "contractVersion": "3.3.0",
  "executionPolicy": {
    "rustVerifyProcessTimeoutMs": 900000,
    "rustVerifyMaxTimeoutMs": 3600000,
    "verifyCleanupGraceMs": 5000
  },
  "toolProfiles": {
    "investigate": [
      "harness_bootstrap",
      "harness_explore",
      "harness_symbols",
      "harness_search",
      "harness_read",
      "harness_detail",
      "harness_data_query",
      "harness_git",
      "harness_ignore",
      "harness_doctor",
      "harness_batch",
      "harness_session"
    ],
    "edit": [
      "harness_ignore",
      "harness_replace",
      "harness_write",
      "harness_move",
      "harness_delete",
      "harness_proposal",
      "harness_verify"
    ]
  },
  "alwaysLoadTools": [
    "harness_bootstrap",
    "harness_explore"
  ],
  "nativeIndexMaintenance": {
    "activation": "Automatic on Windows with full profile and existing compatible native index; HARNESS_INDEX_WATCH=0 disables, 1 requires startup",
    "defaultEnabled": true,
    "requiresLlmSyncCalls": false,
    "debounceMs": 600,
    "maxDebounceMs": 2000,
    "maxPendingPaths": 1024,
    "reconcileSeconds": 300,
    "status": "harness_doctor checks[id=index-auto-sync].details",
    "globalFreshnessCertified": false
  },
  "llmPolicy": {
    "version": 1,
    "rules": [
      "Investigate/review default to read-only: no edits, builds, tests or reindex unless needed and authorized.",
      "One narrow call first; batch independent reads only; expand missing evidence, not everything.",
      "Rust bootstrap: copy data.session into the session argument of later calls. Start from exampleCall and change only query; sessionId is a legacy response alias.",
      "Reuse current source/hashes. Signatures and summaries are not replacement text.",
      "Preserve freshness, truncation and ambiguity. Empty bounded results do not prove absence.",
      "After runtime/transport/timeout failure stop and diagnose; never bypass the harness."
    ],
    "routing": [
      {
        "need": "Assess indexed callers before renaming or changing a signature",
        "tool": "harness_explore",
        "backends": [
          "rust"
        ],
        "defaults": {
          "view": "impact",
          "maxDepth": 1,
          "limit": 20
        },
        "then": "Use filePath and exact symbol. Inspect ambiguity, freshness and graph limits; locations are caller declarations."
      },
      {
        "need": "Preview a replacement and syntax diagnostics without publishing",
        "tool": "harness_replace",
        "backends": [
          "node",
          "rust"
        ],
        "defaults": {
          "preview": true
        },
        "then": "Same arguments as harness_replace. Apply the reviewed replacement using baseHash; stale sources are rejected."
      },
      {
        "need": "Inspect recent errors and stack context from a background verification job",
        "tool": "harness_jobs",
        "backends": [
          "rust"
        ],
        "defaults": {
          "action": "observe",
          "lines": 20,
          "before": 2,
          "after": 2
        },
        "then": "Use taskId and regex filter. Follow cursor; inspect gap, truncated and outputLimited."
      },
      {
        "need": "Manage workflow progress, checkpoint goals/decisions, check status, or generate handover",
        "tool": "harness_session",
        "backends": [
          "rust"
        ],
        "defaults": {},
        "then": "Use action=checkpoint to record goals/decisions, action=tasks for phases and timeline, action=status for live summary, and action=handover for closure."
      },
      {
        "need": "Locate a file by name; literals use search kind=text",
        "tool": "harness_search",
        "backends": [
          "node",
          "rust"
        ],
        "defaults": {
          "kind": "files",
          "limit": 8
        },
        "then": "Known file: outline with relevant query; do not read whole files."
      },
      {
        "need": "Relationships of a known symbol",
        "tool": "harness_explore",
        "backends": [
          "rust"
        ],
        "defaults": {
          "view": "full",
          "maxFiles": 4,
          "maxChars": 12000,
          "requireMatchingFiles": true
        },
        "then": "Disambiguate with filePath; project missing graph fields with resultRef=detail.ref."
      },
      {
        "need": "Investigate relationships",
        "tool": "harness_explore",
        "backends": [
          "node"
        ],
        "defaults": {
          "maxFiles": 1,
          "maxChars": 2000
        },
        "then": "Frozen or truncated graphs are not complete current evidence."
      },
      {
        "need": "Structure in a known file",
        "tool": "harness_outline",
        "backends": [
          "node"
        ],
        "defaults": {
          "maxChars": 2500
        },
        "then": "query ranks relevant declarations."
      },
      {
        "need": "Signature or declaration location",
        "tool": "harness_read_symbol",
        "backends": [
          "node"
        ],
        "defaults": {
          "view": "signature"
        },
        "then": "Implementation/editing questions: request full directly, not signature then full. Reuse exact text/hash already received."
      },
      {
        "need": "Structure in a known file",
        "tool": "harness_symbols",
        "backends": [
          "rust"
        ],
        "defaults": {
          "action": "outline",
          "maxChars": 2500
        },
        "then": "query ranks relevant declarations; omissions remain in detail."
      },
      {
        "need": "Signature or declaration location",
        "tool": "harness_symbols",
        "backends": [
          "rust"
        ],
        "defaults": {
          "action": "read",
          "view": "signature"
        },
        "then": "For implementation or editing, request view=full directly. Preserve source, docs, hash and symbolId."
      },
      {
        "need": "Filter a stored result",
        "tool": "harness_data_query",
        "backends": [
          "rust"
        ],
        "defaults": {
          "maxChars": 2000
        },
        "then": "Use resultRef and projection/slice, not the complete JSON through the LLM."
      },
      {
        "need": "SQL discovery",
        "tool": "harness_sql_search",
        "backends": [
          "node"
        ],
        "defaults": {
          "limit": 10
        },
        "then": "Describe the discovered exact object before a bounded read-only query."
      },
      {
        "need": "SQL discovery",
        "tool": "harness_sql",
        "backends": [
          "rust"
        ],
        "defaults": {
          "action": "search",
          "limit": 10
        },
        "then": "Inspect exact objects with action=describe; never guess columns. Batch independent SQL describes with harness_batch jobs tool=harness_sql (1..4 jobs, maxConcurrent 2..4, default 2). PostgreSQL arbitrary query is unavailable; opt-in schemaCacheSeconds 0..300 caches describe snapshots, refresh=true bypasses and replaces them. Cached permissions/DDL are not revalidated."
      },
      {
        "need": "Run verification in background and follow completion without blocking",
        "tool": "harness_jobs",
        "backends": [
          "rust"
        ],
        "defaults": {
          "action": "list"
        },
        "then": "Start with verify; retain taskId and event sequence. Follow events/status or cancel. Retry only recognized transient failures; completion notifications require client support."
      },
      {
        "need": "Recent error or slow request",
        "tool": "harness_doctor",
        "backends": [
          "rust"
        ],
        "defaults": {
          "action": "logs",
          "limit": 5
        },
        "then": "Doctor for diagnosis; sql_status also for SQL failures; no uncertain mutation retries."
      }
    ],
    "workflows": {
      "investigate": [
        "Choose one entry point; unknown native symbol: locate file/declaration first.",
        "Follow exact relationships; read only missing relevant bodies.",
        "Stop once current evidence answers the question; report uncertainty."
      ],
      "fix": [
        "Inspect relationships and exact current source/hash.",
        "Smallest validated edit.",
        "Diagnostics and relevant verification only, not full suites by default.",
        "Review diff and report observed results."
      ],
      "performance": [
        "Freeze inputs; exclude compilation from execution timing.",
        "Measure one suspected component; change one cause; compare results.",
        "Microbenchmark gains are not whole-system gains."
      ]
    }
  },
  "backends": {
    "node": {
      "batchTools": [
        "harness_read",
        "harness_config",
        "harness_read_symbol",
        "harness_outline",
        "harness_search",
