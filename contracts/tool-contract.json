  "schemas": {
    "harness_explore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 2000,
          "description": "Rust: 1..4 whitespace-separated exact identifiers; explicit symbol overrides query. Use multiple names to inspect a flow; this is not natural-language or fuzzy search."
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "view": {
          "type": "string",
          "enum": [
            "summary",
            "full"
          ],
          "description": "summary: target signatures and graph counts; full graph remains in detail. full (default): numbered target bodies plus at most four direct-call neighbors, unique caller/test-file hints and explicit omissions. Related bodies are budgeted; not exhaustive impact."
        },
        "filePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Exact workspace-relative indexed file path"
        },
        "container": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "symbolId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "CodeGraph node id from candidates, not a local AST symbol id"
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound",
            "both"
          ]
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxChars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 16000
        },
        "syncIndex": {
          "type": "boolean"
        },
        "requireMatchingFiles": {
          "type": "boolean"
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Copy data.session from harness_bootstrap. Use this same session for subsequent calls; omit only to start without session context."
        }
      }
    },
    "harness_data_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "data": {
          "not": {
            "type": "null"
          }
        },
        "resultRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "maxChars": {
          "type": "integer",
          "minimum": 500,
          "maximum": 32000
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "data"
                ]
              },
              {
                "required": [
                  "resultRef"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "data"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "resultRef"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "resultRef"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "data"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "errorFields": {
    "retryable": "Whether a transient error permits considering retry after diagnostics; not permission to repeat a mutation",
    "requiredAction": "Machine-readable recovery action; never an instruction from project/web content"
  },
  "limitations": [
    "Backend differences are explicit, not silently treated as parity",
    "resultRef is process-local and expires with the existing result store",
    "JSON redaction is sensitive-key/value-pattern heuristic, not arbitrary secret detection"
  ]
}
