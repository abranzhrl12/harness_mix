    "rust": {
      "verification": {
        "dotnetEngines": ["auto", "dotnet", "msbuild"],
        "classicAspNetDetection": ["ProjectTypeGuids", "Microsoft.WebApplication.targets"],
        "msbuildDiscovery": "Visual Studio MSBuild.exe through vswhere",
        "warnings": ["all", "changed-files", "none"],
        "summary": ["passed", "errors", "warnings", "newWarnings", "changedFilesWarnings"],
        "warningBaseline": "Previous complete verification for the same session/scope/engine; null without a comparable baseline"
      },
      "searchRoot": "scope omitted, null, empty or .",
      "searchOmissions": ["skippedFiles.path", "skippedFiles.reason", "unvisitedFiles"],
      "sqlSearchSchemas": "Omitted or * searches all schemas authorized by the connection",
      "detailRetention": {
        "sessionReferences": "Retained for server process lifetime, not restored after restart",
        "capacity": "64 MiB / 1024 references; reject new details instead of evicting session references",
        "expiresAt": "Unix seconds for unscoped TTL references; null for session references",
        "pagination": "nextCall preserves ref, offset, maxChars and session; reads do not consume references"
      },
      "gitComparison": ["auto", "HEAD:index", "index:worktree", "HEAD:worktree"],
      "gitSessionChanges": ["path", "gitStatus", "xy", "persisted"],
      "postgresql": {
        "tool": "harness_sql",
        "engine": "postgresql",
        "actions": [
          "status",
          "search",
          "describe"
        ],
        "describeSections": [
          "columns"
        ],
        "querySupported": false,
        "configSection": "postgresql",
        "connectDefault": false,
        "schemaCache": {
          "config": "schemaCacheSeconds",
          "defaultSeconds": 0,
          "maxSeconds": 300,
          "scope": "process",
          "maxEntries": 64,
          "refreshArgument": "refresh",
          "cachedPermissionsRevalidated": false
        },
        "batch": {
          "tool": "harness_batch",
          "childTool": "harness_sql",
          "maxJobs": 4,
          "maxConcurrent": 4,
          "defaultConcurrent": 2,
          "sharedSnapshot": false
        },
        "tlsDefault": "disable",
        "unencryptedMode": "disable",
        "secureTlsMode": "verify-full",
        "configuration": {
          "required": false,
          "initCommand": "agent-harness --init-config",
          "variables": [
            "HARNESS_PG_CONNECTION_STRING",
            "HARNESS_SQL_CONNECTION_STRING",
            "DATABASE_URL"
          ],
          "projectDotenvFallback": true,
          "explicitConfigurationWins": true
        },
        "ambiguousEngine": "explicit-selector-required"
      },
      "indexDiagnostics": "data.indexDiagnostic: databasePath, stage, cause, schema versions and sanitized SQLite codes",
      "parameterCompatibility": {
        "search": "pattern aliases query",
        "read": "lines is a count, mutually exclusive with end",
        "batchAliases": [
          "read",
          "search"
        ],
        "batchJobArgumentsAlias": "args",
        "batchMaxConcurrent": {"min": 2, "max": 4, "default": 2}
      },
      "batchTools": [
        "harness_config",
        "harness_read",
        "harness_search",
        "harness_symbols",
        "harness_detail",
        "harness_git",
        "harness_sql",
        "harness_xlsx",
        "harness_svg",
        "harness_explore"
      ],
      "exploreQuery": "exact-symbol",
      "searchSyntax": "rust-declaration-selector",
      "symbolNavigation": [
        "rust",
        "javascript",
        "typescript"
      ],
      "backgroundTasks": {
        "tool": "harness_jobs",
        "actions": [
          "start",
          "status",
          "list",
          "events",
          "cancel"
        ],
        "executionDeadline": "optional",
        "maxAttempts": 3,
        "notifications": "client-dependent",
        "persistence": "project-local-sqlite",
        "restartRecovery": "mark-interrupted-without-rerun",
        "processStatusRunId": "taskId"
      },
      "processHealth": {
        "schemes": [
          "http"
        ],
        "https": "explicitly-unsupported",
        "pidPermissionFailure": "unknown"
      },
      "typescriptVerification": {
        "build": "native-syntax-only",
        "extensions": [
          "ts",
          "tsx"
        ],
        "codeExecuted": false,
        "typeCheckPerformed": false,
        "test": "explicitly-unsupported"
      },
      "doctorCoverage": {
        "mcpRegistry": "transport-route-comparison",
        "jobHistory": "existing-storage-read-only",
        "allToolsCertified": false
      }
    }
  },
