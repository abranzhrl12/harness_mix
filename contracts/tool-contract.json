        "harness_git_diff",
        "harness_xlsx_inspect",
        "harness_xlsx_read",
        "harness_process_status"
      ],
      "exploreQuery": "natural-language-or-symbol",
      "searchSyntax": "ast-pattern"
    },
    "rust": {
      "batchTools": [
        "harness_config",
        "harness_read",
        "harness_search",
        "harness_outline",
        "harness_read_symbol",
        "harness_detail",
        "harness_git_status",
        "harness_git_diff",
        "harness_sql",
        "harness_xlsx_inspect",
        "harness_xlsx_read",
        "harness_svg"
      ],
      "exploreQuery": "exact-symbol",
      "searchSyntax": "rust-declaration-selector",
      "symbolNavigation": ["rust", "javascript", "typescript"],
      "backgroundTasks": {
        "tool": "harness_jobs",
        "actions": ["start", "status", "list", "events", "cancel"],
        "executionDeadline": "optional",
        "maxAttempts": 3,
        "notifications": "client-dependent",
        "persistence": "project-local-sqlite",
        "restartRecovery": "mark-interrupted-without-rerun",
        "processStatusRunId": "taskId"
      },
      "processHealth": {
        "schemes": ["http"],
        "https": "explicitly-unsupported",
        "pidPermissionFailure": "unknown"
      },
      "typescriptVerification": {
        "build": "native-syntax-only",
        "extensions": ["ts", "tsx"],
        "codeExecuted": false,
        "typeCheckPerformed": false,
        "test": "explicitly-unsupported"
      },
      "doctorCoverage": {
        "mcpRegistry": "transport-route-comparison",
        "jobHistory": "existing-storage-read-only",
        "allToolsCertified": false
      }
    }
  },
