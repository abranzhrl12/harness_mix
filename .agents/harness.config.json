{
  "sqlServer": {
    "enabled": false,
    "backend": "tiberius",
    "defaultSchema": "dbo",
    "maxRows": 50,
    "timeoutSeconds": 15,
    "maxChars": 8000,
    "schemaCacheSeconds": 300,
    "connection": {
      "source": "environment"
    }
  },
  "postgresql": {
    "enabled": true,
    "defaultSchema": "public",
    "allowedSchemas": [
      "public"
    ],
    "maxRows": 50,
    "timeoutSeconds": 15,
    "maxChars": 8000,
    "schemaCacheSeconds": 150,
    "connection": {
      "source": "environment",
      "name": "HARNESS_SQL_CONNECTION_STRING",
      "envFile": ".env"
    },
    "tls": {
      "mode": "disable"
    }
  }
}