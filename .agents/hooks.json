{
  "harnessmix-native-tools": {
    "PreToolUse": [
      {
        "matcher": "^(view_file|view_file_outline|view_code_item|list_dir|find_by_name|grep_search|codebase_search|write_to_file|replace_file_content|multi_replace_file_content|run_command|read_file|search_files|edit_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "harnessmix hook deny-native",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
